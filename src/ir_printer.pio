.program ir_printer
.side_set 1

public ir_high:
    out x, 1            side 1

lolo:
    nop                 side 0 [13]

.wrap_target
    nop                 side 0 [11]

public ir_start:
    out x, 1            side 0
    jmp !x, lolo        side 0

hilo:
    set x, 6            side 0

public hilo_loop:
    nop                 side 1
    jmp x--, hilo_loop  side 0

.wrap

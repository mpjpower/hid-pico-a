// HP Prime PPL Communication Library for Pico

#pragma mode( separator(.,;) integer(h32) )

EXPORT Open()
BEGIN
  LOCAL sts:={};

  IF EQ(USBOpen(),{{#CAFEh,#4001h}}) THEN
    IF EQ(USBOpen(#CAFEh,#4001h),{64,64}) THEN
      sts:={0, "Pico connected"};
    ELSE
      USBOpen();
      sts:={1, "Pico response error"};
    END;
  ELSE
    USBOpen();
    sts:={1, "Pico not connected"};
  END;

  // Clear any stale packets so first command gets a fresh response.
  IF TYPE(sts)==6 AND SIZE(sts)>=1 AND sts[1]==0 THEN
    FlushUsbRx(16);
  END;

  RETURN sts;
END;


EXPORT PicoVersion()
BEGIN
  LOCAL msg:=Send("V");
  IF TYPE(msg)==6 THEN
    RETURN CHAR(msg[2]);
  ELSE
    RETURN msg;
  END;
END;


EXPORT LedOn()
BEGIN
  LOCAL msg:=Send("L");
  IF TYPE(msg)==6 THEN
    RETURN CHAR(msg[2]);
  ELSE
    RETURN msg;
  END;
END;

EXPORT LedOff()
BEGIN
  LOCAL msg:=Send("O");
  IF TYPE(msg)==6 THEN
    RETURN CHAR(msg[2]);
  ELSE
    RETURN msg;
  END;
END;


EXPORT SetUartBaudRate(baudrate)
BEGIN
  LOCAL msg:=Send("U "+baudrate);
  IF TYPE(msg)==6 THEN
    RETURN CHAR(msg[2]);
  ELSE
    RETURN msg;
  END;
END;


EXPORT GetRegs(devname, regs)
BEGIN
  LOCAL cmd;
  LOCAL recv;
  LOCAL txt;

  IF TYPE(regs)<>6 THEN
    RETURN {1,"regs must be a list"};
  END;

  cmd:="J "+devname+" "+STRING(regs);
  recv:=Send(cmd);

  IF TYPE(recv)<>6 THEN
    RETURN {1,"No response"};
  END;

  txt:=CHAR(recv[2]);
  IF LEFT(txt,2)=="0 " THEN
    RETURN {0,EXPR(RIGHT(txt,SIZE(txt)-2))};
  END;

  RETURN {1,txt};
END;


EXPORT SetRegs(devname, pairs)
BEGIN
  LOCAL cmd;
  LOCAL recv;
  LOCAL txt;

  IF TYPE(pairs)<>6 THEN
    RETURN {1,"pairs must be a list"};
  END;

  IF (SIZE(pairs) MOD 2)<>0 THEN
    RETURN {1,"pairs must be {reg,val,...}"};
  END;

  cmd:="I "+devname+" "+STRING(pairs);
  recv:=Send(cmd);

  IF TYPE(recv)<>6 THEN
    RETURN {1,"No response"};
  END;

  txt:=CHAR(recv[2]);
  IF LEFT(txt,2)=="0 " THEN
    RETURN {0,txt};
  END;

  RETURN {1,txt};
END;

EXPORT SendUart(msg)
BEGIN
  // TYPE 2=string, 6=list

  CASE
  IF TYPE(msg)==6 THEN
    // Send as bytes (allows control characters)
    RETURN Send(CONCAT(ASC("S"),CONCAT(ASC(" "),msg)));
  END

  IF TYPE(msg)==2 THEN
    // Send a string (strings don't allow control characters)
    RETURN Send("S "+msg); 
  END

  RETURN({1, "Type not handled"});
  END;
END;


EXPORT ReceiveUartBytesTimed(timeout_ms)
BEGIN
  LOCAL resp:=SendTimed("R", timeout_ms);
  LOCAL recv;
  LOCAL msg:={};
  LOCAL c:=1;

  IF TYPE(resp)==6 AND SIZE(resp)>=2 AND resp[1]==0 THEN
    recv:=resp[2];

    IF TYPE(recv)==6 THEN
      WHILE (c<=SIZE(recv)) AND (recv[c]<>0) DO
        msg(0):=recv[c];
        c:=c+1;
      END;
    END;
  END;

  RETURN(msg);
END;


EXPORT ReceiveUartBytes()
BEGIN
  // Default timeout for generic callers.
  RETURN ReceiveUartBytesTimed(10);
END;


EXPORT SendTimed(cmd, timeout_ms)
BEGIN
  LOCAL msg;

  CASE
  IF TYPE(cmd)==2 THEN
    // If a string then convert to list and append null
    cmd:=CONCAT(ASC(cmd),0);
  END

  IF TYPE(cmd)==6 THEN
    // Already a list, so just append null
    cmd:=CONCAT(cmd,0);
  END

  RETURN({1, "Type not handled"});
  END;

  // Drop delayed responses from previous timed-out commands.
  FlushUsbRx(16);

  USBSend(cmd);

  msg:=WaitForMessage(timeout_ms);

  IF TYPE(msg)==6 AND SIZE(msg)>0 THEN
    RETURN({0,msg});
  ELSE
    RETURN(0);
  END;
END;


EXPORT FlushUsbRx(max_reads)
BEGIN
  LOCAL i;
  LOCAL pkt;

  IF TYPE(max_reads)<>0 OR max_reads<=0 THEN
    max_reads:=8;
  END;

  FOR i FROM 1 TO max_reads DO
    pkt:=USBRecv();
    IF NOT(TYPE(pkt)==6 AND SIZE(pkt)>0) THEN
      RETURN 0;
    END;
  END;

  RETURN 0;
END;


EXPORT Send(cmd)
BEGIN
  // Default timeout for control/configuration commands.
  RETURN SendTimed(cmd, 50);
END;


EXPORT ScanI2CTimed(timeout_ms)
BEGIN
  LOCAL recv;
  LOCAL txt;
  LOCAL addrs:={};
  LOCAL i;
  LOCAL ch;
  LOCAL nib;
  LOCAL base;
  LOCAL q;
  LOCAL b;

  IF TYPE(timeout_ms)<>0 OR timeout_ms<1 THEN
    timeout_ms:=300;
  END;

  recv:=SendTimed("Q", timeout_ms);

  IF TYPE(recv)<>6 OR SIZE(recv)<2 OR recv[1]<>0 THEN
    RETURN {1,"No response"};
  END;

  txt:=CHAR(recv[2]);

  // Accept either raw bitmap or status-prefixed form "0 <bitmap>".
  IF LEFT(txt,2)=="0 " THEN
    txt:=RIGHT(txt,SIZE(txt)-2);
  END;

  IF SIZE(txt)<32 THEN
    RETURN {1,"Invalid bitmap length"};
  END;

  txt:=LEFT(txt,32);

  FOR i FROM 1 TO 32 DO
    ch:=MID(txt,i,1);
    nib:=ASC(ch)-48;
    nib:=nib(1);

    IF nib>9 THEN
      nib:=nib-7;
    END;    

    IF nib<0 OR nib>15 THEN
      RETURN {1,"Invalid hex bitmap"};
    END;

    base:=4*(i-1);
    q:=nib;

    FOR b FROM 0 TO 3 DO
      IF (q MOD 2)==1 THEN
        addrs(0):=base+b;
      END;
      q:=IP(q/2);
    END;
  END;

  RETURN addrs;
END;


EXPORT ScanI2C()
BEGIN
  // Q command scans all addresses and can exceed the 50 ms default timeout.
  RETURN ScanI2CTimed(300);
END;


EXPORT SelfTestPico(iterations)
BEGIN
  LOCAL n;
  LOCAL i;
  LOCAL results:={};
  LOCAL stats:={0,0}; // {pass,fail}
  LOCAL r;
  LOCAL name;
  LOCAL ok;

  IF TYPE(iterations)<>0 OR iterations<1 THEN
    n:=3;
  ELSE
    n:=IP(iterations);
    IF n<1 THEN
      n:=1;
    END;
  END;

  // Ensure link is up before testing command flows.
  r:=Open();
  IF NOT(TYPE(r)==6 AND SIZE(r)>=1 AND r[1]==0) THEN
    RETURN {0,1,{{"Open",0,r}}};
  END;

  // Test V command shape.
  name:="PicoVersion";
  r:=PicoVersion();
  ok:=(TYPE(r)==2 AND SIZE(r)>0);
  IF ok THEN
    stats[1]:=stats[1]+1;
  ELSE
    stats[2]:=stats[2]+1;
  END;
  results(0):={name,ok,r};

  // Test LED command path.
  name:="LedOn";
  r:=LedOn();
  ok:=(TYPE(r)==2 OR (TYPE(r)==6 AND SIZE(r)>=1 AND r[1]==0));
  IF ok THEN
    stats[1]:=stats[1]+1;
  ELSE
    stats[2]:=stats[2]+1;
  END;
  results(0):={name,ok,r};

  WAIT(0.5);

  name:="LedOff";
  r:=LedOff();
  ok:=(TYPE(r)==2 OR (TYPE(r)==6 AND SIZE(r)>=1 AND r[1]==0));
  IF ok THEN
    stats[1]:=stats[1]+1;
  ELSE
    stats[2]:=stats[2]+1;
  END;
  results(0):={name,ok,r};

  // Repeat scan/version to detect one-command lag.
  FOR i FROM 1 TO n DO
    name:="ScanI2C["+STRING(i)+"]";
    r:=ScanI2C();
    ok:=(TYPE(r)==6 AND (SIZE(r)==0 OR TYPE(r[1])==0));
    IF ok THEN
      stats[1]:=stats[1]+1;
    ELSE
      stats[2]:=stats[2]+1;
    END;
    results(0):={name,ok,r};

    name:="PicoVersionAfterScan["+STRING(i)+"]";
    r:=PicoVersion();
    ok:=(TYPE(r)==2 AND SIZE(r)>0);
    IF ok THEN
      stats[1]:=stats[1]+1;
    ELSE
      stats[2]:=stats[2]+1;
    END;
    results(0):={name,ok,r};
  END;

  RETURN {stats[1],stats[2],results};
END;


EXPORT WaitForMessage(timeout_ms)
BEGIN
  LOCAL sts:={};
  LOCAL start_ticks:=TICKS;

  IF timeout_ms<0 THEN
    timeout_ms:=0;
  END;

  REPEAT
    sts:=USBRecv();

    IF TYPE(sts)==6 AND SIZE(sts)>0 THEN
      RETURN(sts);
    END;
  UNTIL (TICKS-start_ticks)>=timeout_ms;

  RETURN({});
END;

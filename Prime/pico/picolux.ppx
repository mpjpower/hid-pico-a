#pragma mode(separator(.,;) integer(h32))

//==========================================================================
// Light sensor library by Mark Power
// 
// Supports the TSL2591 light sensor over i2c via Raspberry Pi Pico
//
// i2c SDA = Pico pin 6
// i2c SCL = Pico pin 7
//
// Important: The Pico and Plot4g programs must have been downloaded
// to the Prime and checked before the PicoLux library can be used.
//
// Note: using gain > low (1x) or integration time > 100ms in bright light
// appears to cause an overflow on channel 0 (full spectrum light) even
// though ch0 is not 65535. For this reason, to cope with bright sunlight
// or a smart phone torch on full close up, the default configuration is
// set to low gain and 100ms. If you are dealing with darker environments
// you may want to try increasing the gain or integration time. However,
// check that the counters are not overflowing.
//
//==========================================================================
//

EXPORT luxEnabled;
LOCAL again;
LOCAL atime;

// Constants
LOCAL TSL2591_GAIN_LOW:=  0;
LOCAL TSL2591_GAIN_MED:=  16;
LOCAL TSL2591_GAIN_HIGH:= 32;
LOCAL TSL2591_GAIN_MAX:=  48;

LOCAL TSL2591_INTEGRATIONTIME_100MS:= 0;
LOCAL TSL2591_INTEGRATIONTIME_200MS:= 1;
LOCAL TSL2591_INTEGRATIONTIME_300MS:= 2;
LOCAL TSL2591_INTEGRATIONTIME_400MS:= 3;
LOCAL TSL2591_INTEGRATIONTIME_500MS:= 4;
LOCAL TSL2591_INTEGRATIONTIME_600MS:= 5;

LOCAL TSL2591_LUX_DF:=408;   // Lux cooefficient from line 55 of
                       // https://github.com/adafruit/Adafruit_TSL2591_Library/blob/master/Adafruit_TSL2591.h (as at 14/11/2023)

// Results Matrix for the GUI
LOCAL NUMBER_RESULTS:=120;
LOCAL res_list;

//==========================================================================
// Initialise the sensor and set the luxEnabled global variable.
// Applications should call this function before Read() and check the
// status returned which is a list of a status code and error string
// Status code 0 means the light sensor is not connected
// Status code 1 is positive and the lunEnabled flag should be checked.
//==========================================================================

EXPORT Init()
BEGIN
  LOCAL sts;
  luxEnabled:=0;

  sts:=Pico.Open();

  IF sts(1)==0 THEN
    // Write to Enable Register #0: ALS Enable, Power On
    sts:=SetRegs("tsl2591", {0, 3});

    IF sts(1)==0 THEN
      luxEnabled:=1;

      again:=TSL2591_GAIN_LOW;
      atime:=TSL2591_INTEGRATIONTIME_100MS;

      // Configure TSL2591 light sensor     
      // Write to Control Register #1: Gain + Integration Time

      Pico.SetRegs("tsl2591", {1, again+atime});  
    ELSE
      sts:={1,"TSL2591 not connected"};
    END;
  END;

  RETURN(sts);
END;

//==========================================================================
// After initialising the sensor, you can optionally set the gain to be
// 0 = Low gain (needed to cope with bright sunlight and very bright lights)
// 1 = Medium
// 2 = High
// 3 = Max
//==========================================================================

EXPORT SetGain(g)
BEGIN
  LOCAL ga:=FLOOR(g);

  CASE
    IF ga<0 THEN again:=TSL2591_GAIN_LOW; END;
    IF ga>3 THEN again:=TSL2591_GAIN_MAX; END;
    DEFAULT again:=16*ga;
  END;

  Pico.SetRegs("tsl2591", {1, again+atime});
END;

//==========================================================================
// After initialising the sensor, you can optionally set the integration time
// that the sensor uses to determine the light levels.
// 0 = 100ms (needed to cope with bright sunlight and very bright lights)
// 1 = 200ms
// 2 = 300ms
// 3 = 400ms
// 4 = 500ms
// 5 = 600ms
//==========================================================================

EXPORT SetIntegrationTime(t)
BEGIN
  LOCAL ti:=FLOOR(t);

  CASE
    IF ti<0 THEN atime:=TSL2591_INTEGRATIONTIME_100MS; END;
    IF ti>5 THEN atime:=TSL2591_INTEGRATIONTIME_600MS; END;
    DEFAULT atime:=ti;
  END;

  Pico.SetRegs("tsl2591", {1, again+atime});
END;

//==========================================================================
// Calculate Lux from {STATUS, C0DATAL, C0DATAH, C1DATAL, C1DATAH} using the
// gain and timing parameters for data collection. Returns -1 if there is
// an overflow caused by the intergation time being too long and/or
// the gain being set too high in bright light.
//==========================================================================

CalculateLux(ch0, ch1)
BEGIN
  // Gain and time are currently set in Init()
  LOCAL atimeMultiplier:=(atime+1)*100; // Convert gain setting to multiplier
  LOCAL againMultiplier:=0;

  CASE
    IF again == TSL2591_GAIN_LOW  THEN againMultiplier:=1; END;
    IF again == TSL2591_GAIN_MED  THEN againMultiplier:=25; END;
    IF again == TSL2591_GAIN_HIGH THEN againMultiplier:=428; END;
    IF again == TSL2591_GAIN_MAX  THEN againMultiplier:=9876; END;
  END;

  // Check for overflow
  IF ch0==65535 OR ch1==65535 THEN
    RETURN(-1);
  END;  

  // Check for no light seen in the full spectrum sensor which would
  // lead to a divide by zero error in the following lux calculation
  IF ch0==0 THEN
    RETURN(0);
  END;

  // From https://github.com/adafruit/Adafruit_TSL2591_Library/blob/master/Adafruit_TSL2591.cpp (as of 14/11/2023)
  // cpl = (atime * again) / TSL2591_LUX_DF;  // Line 276
  // lux = (((float)ch0 - (float)ch1)) * (1.0F - ((float)ch1 / (float)ch0)) / cpl;  // Line 285

  LOCAL cpl:=(atimeMultiplier*againMultiplier)/TSL2591_LUX_DF;
  LOCAL lux:=(ch0-ch1)*(1-(ch1/ch0))/cpl;

  RETURN(lux);
END;

//==================================================================================
// Read light sensor and return {time, full spectrum, infrared, visible, lux}
//==================================================================================

EXPORT Read()
BEGIN
  LOCAL regs, result, retval;

  IF luxEnabled THEN
    result:= GetRegs("tsl2591", {20, 21, 22, 23});
    regs:=result(2);
  END;

  // Calculate the 16-bit values from low and high bytes
  LOCAL ch0:=regs(2)*256+regs(1);
  LOCAL ch1:=regs(4)*256+regs(3);

  // See https://en.wikipedia.org/wiki/Lux
  LOCAL lux:=CalculateLux(ch0, ch1);

  retval:={};
  retval(0):=Time;       // Time
  retval(0):=ch0;        // full spectrum reading
  retval(0):=ch1;        // infrared reading
  retval(0):=ch0-ch1;    // visible reading
  retval(0):=lux;        // calculated lux

  RETURN(retval);
END;

//==========================================================================
// Close and flush the i2c hid interface
//==========================================================================

EXPORT Close()
BEGIN
  IF luxEnabled THEN
    Pico.SetRegs("tsl2591", {0, 0});  // ALS Disable, Power Off
    USBOpen();  // close all
    luxEnabled:=0;
  END;
END;

//==========================================================================
// Output {time, full spectrum, infrared, visible, lux} to the console
//==========================================================================

EXPORT LuxTest()
BEGIN
  LOCAL sts;
  LOCAL val;
  LOCAL running:=1;
  LOCAL delay:=1;

  PRINT;

  sts:=Init();
  IF sts(1)==1 THEN
    PRINT(sts);    // Error exit
    RETURN;
  END;

  PRINT("{time, full spectrum, infrared, visible, lux}");

  // Discard the first reading as integration seems to include any previous readings
  val:=Read();

  WHILE running DO
    val:=Read();
    PRINT(STRING(val));

    CASE
      IF ISKEYDOWN(34) THEN delay:=10 END;  // S = Slow (10s refresh)
      IF ISKEYDOWN(20) THEN delay:=1 END;   // F = Fast (1s refresh)
      IF ISKEYDOWN(4) THEN delay:=0; running:=0 END;    // Esc = End
      IF ISKEYDOWN(17) THEN DEBUG END;      // Press D for DEBUG
    END;

    WAIT(delay);
  END;  // End and tidy up when ESC key is pressed

  Close();
END;

//==========================================================================
// Output Graphs of time, full spectrum, infrared, visible, and lux
// Hold Esc to exit, this will leave the results on the stack, which can
// be sent to your PC/Mac or displayed again using LuxResults(matrix)
//==========================================================================

EXPORT LuxGUI() 
BEGIN
  res_list:=MAKEMAT(0, NUMBER_RESULTS, 5);

  LOCAL delay:=1;
  LOCAL running:=1;
  LOCAL res;
  LOCAL sts;

  sts:=Init();
  IF sts(1)==1 THEN
    RETURN(sts);  // Error exit
  END;

  // Discard the first reading as integration seems to include any previous readings
  res:=Read();

  WHILE running DO
    res:=Read();
    // Returns {time, full spectrum, infrared, visible, lux}
    
    // Drop the first row from the result matrix
    DELROW(res_list,1);

    // Store the new result list as the last entry in the result matrix
    ADDROW(res_list, [0,0,0,0,0], NUMBER_RESULTS);
    res_list(NUMBER_RESULTS, 1):=res(1); // Time
    res_list(NUMBER_RESULTS, 2):=res(2); // Full spectrum
    res_list(NUMBER_RESULTS, 3):=res(3); // Infrared
    res_list(NUMBER_RESULTS, 4):=res(4); // Visible
    res_list(NUMBER_RESULTS, 5):=res(5); // Calculated Lux

    // Show the measurement history
    LOCAL s:="S(low) F(ast) or Esc. ";
    s:=s+"Refresh: "+STRING(ROUND(delay,0))+"s. ";

    Plot4g.Plot4g(res_list, {2,3,4,5}, 1, 1, {"Raw Full Spectrum", "Raw Infrared", "Raw Visible", "Lux"}, s);

    CASE
      IF ISKEYDOWN(34) THEN delay:=10 END;  // S = Slow (10s refresh)
      IF ISKEYDOWN(20) THEN delay:=1 END;   // F = Fast (1s refresh)
      IF ISKEYDOWN(4) THEN delay:=0; running:=0 END;    // Esc = End
      IF ISKEYDOWN(17) THEN DEBUG END;      // Press D for DEBUG
    END;

    WAIT(delay);
  END;  // End and tidy up when ESC key is pressed

  Close();

  RETURN(res_list);
END;

//==========================================================================
// Output Graphs of time, full spectrum, infrared, visible, and lux
// from matrix generated by LuxGUI
//==========================================================================

EXPORT LuxResults(res) 
BEGIN
  res_list:=res;

  Plot4g.Plot4g(res_list, {2,3,4,5}, 1, 1, {"Raw Full Spectrum", "Raw Infrared", "Raw Visible", "Lux"}, "");

  FREEZE;
  WAIT();
END;